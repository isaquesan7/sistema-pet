# Banco PostgreSQL (no desenvolvimento local use a URL pública do Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
PORT=3000
NODE_ENV=development
APP_NAME="PetRise API"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Autenticação
JWT_ACCESS_SECRET="gere_um_segredo_forte"
JWT_REFRESH_SECRET="gere_outro_segredo_forte"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=30
# Se "Mantenha-me conectado" estiver ativo, o refresh token não expira por tempo;
# a sessão permanece válida até logout/revogação administrativa.

# Bootstrap do administrador
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@exemplo.com"
# ADMIN_PASSWORD deve ser informado apenas enquanto roda db:create-admin e depois removido.
ADMIN_PASSWORD="troque-esta-senha"

# Organização / tenant
ORGANIZACAO_NOME="Minha Organização"
ORGANIZACAO_NOME_EXIBICAO="Minha Marca"
ORGANIZACAO_SLUG="minha-organizacao"

# Empresa / CNPJ 1
EMPRESA_LOJA_RAZAO_SOCIAL="Razão Social Loja/Consultório"
EMPRESA_LOJA_NOME_FANTASIA="Minha Loja / Consultório"
EMPRESA_LOJA_CNPJ="00000000000000"

# Empresa / CNPJ 2
EMPRESA_BANHO_RAZAO_SOCIAL="Razão Social Banho e Tosa"
EMPRESA_BANHO_NOME_FANTASIA="Meu Banho e Tosa"
EMPRESA_BANHO_CNPJ="00000000000000"

# Portal do cliente (recomenda-se segredos diferentes dos usuários internos)
JWT_CLIENT_ACCESS_SECRET="gere_um_segredo_forte_para_clientes"
JWT_CLIENT_REFRESH_SECRET="gere_outro_segredo_forte_para_clientes"
JWT_CLIENT_ACCESS_EXPIRES="30m"
JWT_CLIENT_REFRESH_EXPIRES_DAYS=30
PORTAL_RESERVA_MINUTOS=10
# development habilita simulador local. Em produção configure um gateway suportado antes de cobrar clientes.
PAYMENT_PROVIDER="development"

# SaaS comercial / Fase 15
# development habilita somente o simulador de cobrança local. Em produção use manual
# até conectar um gateway recorrente real.
SAAS_BILLING_PROVIDER="development"
PETRISE_SUPER_ADMIN_EMAIL="seu-email@exemplo.com"
