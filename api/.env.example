# PetRise API — exemplo para referência.
# No fluxo recomendado, NÃO copie este arquivo entre computadores:
# mantenha os valores no Railway e use `railway run ...` localmente.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
PORT=3000
NODE_ENV=development
APP_NAME="PetRise API"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Usuários internos
JWT_ACCESS_SECRET="gere_um_segredo_aleatorio_com_64_bytes"
JWT_REFRESH_SECRET="gere_outro_segredo_aleatorio_com_64_bytes"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# Portal do cliente
JWT_CLIENT_ACCESS_SECRET="gere_um_segredo_diferente_com_64_bytes"
JWT_CLIENT_REFRESH_SECRET="gere_outro_segredo_diferente_com_64_bytes"
JWT_CLIENT_ACCESS_EXPIRES="30m"
JWT_CLIENT_REFRESH_EXPIRES_DAYS=30
PORTAL_RESERVA_MINUTOS=10
PAYMENT_PROVIDER="development"

# SaaS comercial
SAAS_BILLING_PROVIDER="development"
PETRISE_SUPER_ADMIN_EMAIL="seu-email@exemplo.com"

# Bootstrap opcional / scripts administrativos
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
ORGANIZACAO_NOME="Minha Organização"
ORGANIZACAO_NOME_EXIBICAO="Minha Marca"
ORGANIZACAO_SLUG="minha-organizacao"
EMPRESA_LOJA_RAZAO_SOCIAL="Razão Social Loja/Consultório"
EMPRESA_LOJA_NOME_FANTASIA="Minha Loja / Consultório"
EMPRESA_LOJA_CNPJ="00000000000000"
EMPRESA_BANHO_RAZAO_SOCIAL="Razão Social Banho e Tosa"
EMPRESA_BANHO_NOME_FANTASIA="Meu Banho e Tosa"
EMPRESA_BANHO_CNPJ="00000000000000"

# PRODUÇÃO:
# NODE_ENV=production
# PAYMENT_PROVIDER=manual
# SAAS_BILLING_PROVIDER=manual
# CORS_ORIGINS=https://SEU-ADMIN,https://SEU-PORTAL

# Fase 16 — Storage privado (Railway Bucket/S3 compatível)
STORAGE_PROVIDER="railway_s3"
STORAGE_ENDPOINT="https://t3.storageapi.dev"
STORAGE_BUCKET="nome-do-bucket"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID="use-referencia-do-railway"
STORAGE_SECRET_ACCESS_KEY="use-referencia-do-railway"
STORAGE_URL_STYLE="virtual-host"
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_MB=15
