generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum TipoEmpresa {
  LOJA_CONSULTORIO
  BANHO_TOSA
  OUTRA
}

enum TipoVinculoOrganizacao {
  PROPRIETARIO
  ADMINISTRADOR
  MEMBRO
}

enum ModuloSistema {
  PDV
  ESTOQUE
  CONSULTORIO
  BANHO_TOSA
  FINANCEIRO
  PORTAL_CLIENTE
  PONTO
  FISCAL
  RELATORIOS
}

enum StatusUsuario {
  ATIVO
  INATIVO
  BLOQUEADO
}

enum StatusContaCliente {
  PENDENTE
  ATIVA
  BLOQUEADA
  INATIVA
}

enum SexoPet {
  MACHO
  FEMEA
  NAO_INFORMADO
}

enum TipoItemCatalogo {
  PRODUTO
  SERVICO
}

enum UnidadeEstoque {
  UNIDADE
  QUILOGRAMA
  GRAMA
  LITRO
  MILILITRO
  PACOTE
  CAIXA
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  VENDA
  CONSUMO_INTERNO
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  PERDA
  DEVOLUCAO_CLIENTE
  DEVOLUCAO_FORNECEDOR
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SAIDA
  CANCELAMENTO
}

enum StatusComanda {
  ABERTA
  PARCIALMENTE_FECHADA
  FECHADA
  CANCELADA
}

enum StatusComandaItem {
  ATIVO
  FATURADO
  CANCELADO
}

enum StatusVenda {
  ABERTA
  FINALIZADA
  CANCELADA
  ESTORNADA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
  TRANSFERENCIA
  CREDITO_CLIENTE
  OUTRO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
  ESTORNADO
  REEMBOLSADO
}

enum StatusSessaoCaixa {
  ABERTO
  FECHADO
}

enum TipoMovimentacaoCaixa {
  VENDA
  SUPRIMENTO
  SANGRIA
  ESTORNO
  RECEBIMENTO
  AJUSTE
}

enum StatusFuncionario {
  ATIVO
  AFASTADO
  FERIAS
  DESLIGADO
}

enum TipoRegistroPonto {
  ENTRADA
  INICIO_PAUSA
  FIM_PAUSA
  SAIDA
}

enum OrigemRegistroPonto {
  WEB
  MOBILE
  ADMIN
  IMPORTACAO
}

enum StatusFechamentoPonto {
  ABERTO
  FECHADO
}

enum TipoPacote {
  FIXO
  TEMPORARIO
  PERSONALIZADO
}

enum StatusPacoteCliente {
  ATIVO
  ESGOTADO
  EXPIRADO
  CANCELADO
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
  OUTRO
}

enum AmbienteFiscal {
  HOMOLOGACAO
  PRODUCAO
}

enum TipoDocumentoFiscal {
  NFCE
  NFE
  NFSE
  RECIBO
}

enum StatusDocumentoFiscal {
  PENDENTE
  PROCESSANDO
  AUTORIZADO
  REJEITADO
  CANCELADO
  ERRO
}

// ======================================================
// ORGANIZAÇÃO / TENANT
// ======================================================

model Organizacao {
  id   String @id @default(cuid())
  slug String @unique
  nome String

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  configuracao ConfiguracaoOrganizacao?
  modulos      ModuloOrganizacao[]

  empresas        Empresa[]
  usuarios        UsuarioOrganizacao[]
  clientes        Cliente[]
  contasCliente   ContaCliente[]
  especies        Especie[]
  categoriasItens CategoriaItem[]
  fornecedores    Fornecedor[]
  funcoes         FuncaoFuncionario[]
  funcionarios    Funcionario[]
  pacotesModelo   PacoteModelo[]
  pacotesCliente  PacoteCliente[]
  auditorias      Auditoria[]

  @@index([nome])
  @@map("organizacoes")
}

model ConfiguracaoOrganizacao {
  id            String @id @default(cuid())
  organizacaoId String @unique

  nomeExibicao String?
  logoUrl      String?
  corPrimaria  String?
  corSecundaria String?

  telefone String?
  whatsapp String?
  email    String?
  site     String?

  timezone String @default("America/Sao_Paulo")
  locale   String @default("pt-BR")
  moeda    String @default("BRL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@map("configuracoes_organizacao")
}

model ModuloOrganizacao {
  organizacaoId String
  modulo        ModuloSistema

  habilitado   Boolean @default(true)
  configuracao Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@id([organizacaoId, modulo])
  @@map("modulos_organizacao")
}

// ======================================================
// EMPRESAS / CNPJS
// ======================================================

model Empresa {
  id            String @id @default(cuid())
  organizacaoId String

  tipo TipoEmpresa

  razaoSocial  String
  nomeFantasia String
  cnpj         String @unique

  inscricaoEstadual  String?
  inscricaoMunicipal String?

  telefone String?
  email    String?

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  usuarios UsuarioEmpresa[]
  cargos   Cargo[]

  itensCatalogo        ItemCatalogo[]
  fornecedores         FornecedorEmpresa[]
  movimentacoesEstoque MovimentacaoEstoque[]
  comandaItens         ComandaItem[]
  caixas               Caixa[]
  vendas               Venda[]

  funcionarios  FuncionarioEmpresa[]
  jornadas      JornadaTrabalho[]
  registrosPonto RegistroPonto[]
  fechamentosPonto FechamentoPonto[]

  pacotesModelo  PacoteModelo[]
  pacotesCliente PacoteCliente[]

  configuracaoFiscal ConfiguracaoFiscalEmpresa?
  documentosFiscais DocumentoFiscal[]
  auditorias        Auditoria[]

  @@index([organizacaoId])
  @@map("empresas")
}

// ======================================================
// USUÁRIOS INTERNOS
// ======================================================

model Usuario {
  id String @id @default(cuid())

  nome      String
  email     String @unique
  senhaHash String

  telefone String?

  status StatusUsuario @default(ATIVO)

  ultimoAcesso DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacoes UsuarioOrganizacao[]
  empresas     UsuarioEmpresa[]
  funcionarios Funcionario[]

  movimentacoesEstoque MovimentacaoEstoque[]
  vendas               Venda[]

  sessoesCaixaAbertas  SessaoCaixa[] @relation("SessaoCaixaAbertura")
  sessoesCaixaFechadas SessaoCaixa[] @relation("SessaoCaixaFechamento")

  movimentacoesCaixa MovimentacaoCaixa[]
  sessoes            SessaoUsuario[]

  historicosPreco HistoricoPrecoItem[]
  registrosPontoCriados RegistroPonto[]    @relation("RegistroPontoUsuario")
  ajustesPonto          AjustePonto[]       @relation("AjustePontoUsuario")
  fechamentosPonto      FechamentoPonto[]  @relation("FechamentoPontoUsuario")
  consumosPacote  ConsumoPacote[]
  auditorias      Auditoria[]

  @@map("usuarios")
}

model UsuarioOrganizacao {
  usuarioId     String
  organizacaoId String

  papel TipoVinculoOrganizacao @default(MEMBRO)
  ativo Boolean                @default(true)

  createdAt DateTime @default(now())

  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, organizacaoId])
  @@index([organizacaoId])
  @@map("usuario_organizacoes")
}

// ======================================================
// CARGOS E PERMISSÕES
// ======================================================

model Cargo {
  id String @id @default(cuid())

  empresaId String
  nome      String
  descricao String?

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa    Empresa          @relation(fields: [empresaId], references: [id])
  usuarios   UsuarioEmpresa[]
  permissoes CargoPermissao[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("cargos")
}

model Permissao {
  id String @id @default(cuid())

  codigo    String @unique
  nome      String
  descricao String?

  createdAt DateTime @default(now())

  cargos CargoPermissao[]

  @@map("permissoes")
}

model CargoPermissao {
  cargoId     String
  permissaoId String

  cargo     Cargo     @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([cargoId, permissaoId])
  @@map("cargo_permissoes")
}

model UsuarioEmpresa {
  usuarioId String
  empresaId String
  cargoId   String?

  ativo Boolean @default(true)

  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cargo   Cargo?  @relation(fields: [cargoId], references: [id])

  @@id([usuarioId, empresaId])
  @@index([empresaId])
  @@index([cargoId])
  @@map("usuario_empresas")
}

// ======================================================
// CLIENTES / TUTORES
// ======================================================

model Cliente {
  id            String @id @default(cuid())
  organizacaoId String

  nome String

  cpfCnpj String?

  telefone String?
  whatsapp String?
  email    String?

  dataNascimento DateTime? @db.Date

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  observacoes String? @db.Text

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  conta ContaCliente?
  pets  Pet[]

  comandas       Comanda[]
  vendas         Venda[]
  pacotesCliente PacoteCliente[]

  @@unique([organizacaoId, cpfCnpj])
  @@index([organizacaoId])
  @@index([nome])
  @@index([telefone])
  @@index([whatsapp])
  @@index([email])
  @@map("clientes")
}

model ContaCliente {
  id            String @id @default(cuid())
  organizacaoId String
  clienteId     String @unique

  email    String?
  telefone String?

  senhaHash String

  emailVerificado    Boolean @default(false)
  telefoneVerificado Boolean @default(false)

  status StatusContaCliente @default(PENDENTE)

  ultimoAcesso DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  cliente     Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([organizacaoId, email])
  @@unique([organizacaoId, telefone])
  @@index([organizacaoId])
  @@map("contas_clientes")
}

// ======================================================
// CADASTROS VETERINÁRIOS CONFIGURÁVEIS
// ======================================================

model Especie {
  id            String @id @default(cuid())
  organizacaoId String

  nome String

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  racas       Raca[]
  pets        Pet[]

  @@unique([organizacaoId, nome])
  @@index([organizacaoId])
  @@map("especies")
}

model Raca {
  id String @id @default(cuid())

  especieId String
  nome      String

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  especie Especie @relation(fields: [especieId], references: [id], onDelete: Cascade)
  pets    Pet[]

  @@unique([especieId, nome])
  @@index([especieId])
  @@map("racas")
}

model Pet {
  id String @id @default(cuid())

  clienteId String
  especieId String
  racaId    String?

  nome String

  sexo SexoPet @default(NAO_INFORMADO)

  dataNascimento DateTime? @db.Date

  castrado Boolean?
  cor      String?

  microchip String? @unique

  fotoUrl String?

  alergias             String? @db.Text
  doencasPreexistentes String? @db.Text
  observacoes          String? @db.Text

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id])
  especie Especie @relation(fields: [especieId], references: [id])
  raca    Raca?   @relation(fields: [racaId], references: [id])

  pesos PetPeso[]

  comandaItens  ComandaItem[]
  vendaItens    VendaItem[]
  pacotesCliente PacoteCliente[]
  consumosPacote ConsumoPacote[]

  @@index([clienteId])
  @@index([especieId])
  @@index([racaId])
  @@index([nome])
  @@map("pets")
}

model PetPeso {
  id String @id @default(cuid())

  petId String

  peso Decimal @db.Decimal(6, 2)

  data DateTime @default(now())

  origem     String?
  observacao String?

  createdAt DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([data])
  @@map("pet_pesos")
}

// ======================================================
// CATEGORIAS CONFIGURÁVEIS
// ======================================================

model CategoriaItem {
  id            String @id @default(cuid())
  organizacaoId String
  parentId      String?

  tipo TipoItemCatalogo

  nome      String
  descricao String?
  ordem     Int     @default(0)
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao Organizacao    @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  pai         CategoriaItem?  @relation("CategoriaHierarquia", fields: [parentId], references: [id], onDelete: SetNull)
  filhas      CategoriaItem[] @relation("CategoriaHierarquia")
  itens       ItemCatalogo[]

  @@unique([organizacaoId, tipo, nome])
  @@index([organizacaoId])
  @@index([parentId])
  @@index([tipo])
  @@map("categorias_itens")
}

// ======================================================
// CATÁLOGO COMERCIAL
// ======================================================

model ItemCatalogo {
  id          String  @id @default(cuid())
  empresaId   String
  categoriaId String?

  tipo TipoItemCatalogo

  nome      String
  descricao String? @db.Text

  codigoInterno String?
  codigoBarras  String?

  custoReferencia       Decimal  @default(0) @db.Decimal(12, 2)
  precoVenda            Decimal  @db.Decimal(12, 2)
  markupPercentual      Decimal? @db.Decimal(8, 4)
  margemBrutaPercentual Decimal? @db.Decimal(8, 4)
  lucroBruto            Decimal? @db.Decimal(12, 2)

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa   Empresa        @relation(fields: [empresaId], references: [id])
  categoria CategoriaItem? @relation(fields: [categoriaId], references: [id])

  produto Produto?
  servico Servico?

  historicosPreco HistoricoPrecoItem[]
  fiscalConfig    ConfiguracaoFiscalItem?

  comandaItens ComandaItem[]
  vendaItens   VendaItem[]

  pacoteModeloItens  PacoteModeloItem[]
  pacoteClienteItens PacoteClienteItem[]

  @@unique([empresaId, codigoInterno])
  @@unique([empresaId, codigoBarras])
  @@index([empresaId])
  @@index([categoriaId])
  @@index([nome])
  @@index([tipo])
  @@map("itens_catalogo")
}

model HistoricoPrecoItem {
  id             String  @id @default(cuid())
  itemCatalogoId String
  usuarioId      String?

  custoReferencia       Decimal  @db.Decimal(12, 2)
  precoVenda            Decimal  @db.Decimal(12, 2)
  markupPercentual      Decimal? @db.Decimal(8, 4)
  margemBrutaPercentual Decimal? @db.Decimal(8, 4)
  lucroBruto            Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  itemCatalogo ItemCatalogo @relation(fields: [itemCatalogoId], references: [id], onDelete: Cascade)
  usuario      Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([itemCatalogoId])
  @@index([createdAt])
  @@map("historico_precos_itens")
}

model Produto {
  id     String @id @default(cuid())
  itemId String @unique

  unidade UnidadeEstoque @default(UNIDADE)

  marca          String?
  custoMedio     Decimal @default(0) @db.Decimal(12, 2)
  estoqueMinimo  Decimal @default(0) @db.Decimal(14, 3)

  controlaEstoque Boolean @default(true)
  controlaLote    Boolean @default(false)
  controlaValidade Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item ItemCatalogo @relation(fields: [itemId], references: [id], onDelete: Cascade)

  estoque       EstoqueSaldo?
  lotes         LoteProduto[]
  movimentacoes MovimentacaoEstoque[]

  @@map("produtos")
}

model Servico {
  id     String @id @default(cuid())
  itemId String @unique

  duracaoMinutos Int?

  geraComissao       Boolean  @default(false)
  percentualComissao Decimal? @db.Decimal(5, 2)

  permiteAgendamento Boolean @default(true)
  exigePet           Boolean @default(true)
  exigeProfissional  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item ItemCatalogo @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("servicos")
}

// ======================================================
// FORNECEDORES
// ======================================================

model Fornecedor {
  id            String @id @default(cuid())
  organizacaoId String

  razaoSocial  String?
  nomeFantasia String

  cpfCnpj String?

  telefone String?
  whatsapp String?
  email    String?

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  observacoes String? @db.Text

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao Organizacao         @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  empresas    FornecedorEmpresa[]

  @@unique([organizacaoId, cpfCnpj])
  @@index([organizacaoId])
  @@index([nomeFantasia])
  @@map("fornecedores")
}

model FornecedorEmpresa {
  fornecedorId String
  empresaId    String

  createdAt DateTime @default(now())

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([fornecedorId, empresaId])
  @@map("fornecedor_empresas")
}

// ======================================================
// ESTOQUE
// ======================================================

model EstoqueSaldo {
  id        String @id @default(cuid())
  produtoId String @unique

  quantidade Decimal @default(0) @db.Decimal(14, 3)

  updatedAt DateTime @updatedAt

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("estoque_saldos")
}

model LoteProduto {
  id        String @id @default(cuid())
  produtoId String

  numeroLote String

  dataFabricacao DateTime? @db.Date
  dataValidade   DateTime? @db.Date

  quantidadeAtual Decimal @default(0) @db.Decimal(14, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produto Produto @relation(fields: [produtoId], references: [id])

  movimentacoes MovimentacaoEstoque[]

  @@unique([produtoId, numeroLote])
  @@index([produtoId])
  @@index([dataValidade])
  @@map("lotes_produtos")
}

model MovimentacaoEstoque {
  id String @id @default(cuid())

  empresaId String
  produtoId String
  loteId    String?
  usuarioId String?

  tipo TipoMovimentacaoEstoque

  quantidade     Decimal @db.Decimal(14, 3)
  saldoAnterior  Decimal @db.Decimal(14, 3)
  saldoPosterior Decimal @db.Decimal(14, 3)

  custoUnitario Decimal? @db.Decimal(12, 2)

  origemTipo String?
  origemId   String?

  observacao String? @db.Text

  createdAt DateTime @default(now())

  empresa Empresa      @relation(fields: [empresaId], references: [id])
  produto Produto      @relation(fields: [produtoId], references: [id])
  lote    LoteProduto? @relation(fields: [loteId], references: [id])
  usuario Usuario?     @relation(fields: [usuarioId], references: [id])

  @@index([empresaId])
  @@index([produtoId])
  @@index([loteId])
  @@index([usuarioId])
  @@index([createdAt])
  @@index([origemTipo, origemId])
  @@map("movimentacoes_estoque")
}

// ======================================================
// COMANDAS / VENDAS / CAIXA
// ======================================================

model Comanda {
  id     String @id @default(cuid())
  numero Int    @unique @default(autoincrement())

  clienteId String

  status StatusComanda @default(ABERTA)

  observacoes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fechadaEm DateTime?

  cliente Cliente @relation(fields: [clienteId], references: [id])

  itens  ComandaItem[]
  vendas Venda[]

  @@index([clienteId])
  @@index([status])
  @@index([createdAt])
  @@map("comandas")
}

model ComandaItem {
  id String @id @default(cuid())

  comandaId      String
  empresaId      String
  itemCatalogoId String
  petId          String?

  descricao String

  quantidade Decimal @default(1) @db.Decimal(12, 3)

  valorUnitario Decimal @db.Decimal(12, 2)
  desconto      Decimal @default(0) @db.Decimal(12, 2)
  valorTotal    Decimal @db.Decimal(12, 2)

  origemTipo String?
  origemId   String?

  status StatusComandaItem @default(ATIVO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comanda      Comanda      @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  itemCatalogo ItemCatalogo @relation(fields: [itemCatalogoId], references: [id])
  pet          Pet?         @relation(fields: [petId], references: [id])

  vendaItens VendaItem[]

  @@index([comandaId])
  @@index([empresaId])
  @@index([itemCatalogoId])
  @@index([petId])
  @@index([status])
  @@map("comanda_itens")
}

model Caixa {
  id        String @id @default(cuid())
  empresaId String

  nome      String
  descricao String?

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  sessoes SessaoCaixa[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("caixas")
}

model SessaoCaixa {
  id      String @id @default(cuid())
  caixaId String

  usuarioAberturaId   String
  usuarioFechamentoId String?

  status StatusSessaoCaixa @default(ABERTO)

  dataAbertura   DateTime  @default(now())
  dataFechamento DateTime?

  valorAbertura       Decimal  @default(0) @db.Decimal(12, 2)
  valorFechamento     Decimal? @db.Decimal(12, 2)
  valorEsperado       Decimal? @db.Decimal(12, 2)
  diferencaFechamento Decimal? @db.Decimal(12, 2)

  observacoes String? @db.Text

  caixa Caixa @relation(fields: [caixaId], references: [id])

  usuarioAbertura   Usuario  @relation("SessaoCaixaAbertura", fields: [usuarioAberturaId], references: [id])
  usuarioFechamento Usuario? @relation("SessaoCaixaFechamento", fields: [usuarioFechamentoId], references: [id])

  pagamentos    Pagamento[]
  movimentacoes MovimentacaoCaixa[]

  @@index([caixaId])
  @@index([usuarioAberturaId])
  @@index([status])
  @@index([dataAbertura])
  @@map("sessoes_caixa")
}

model Venda {
  id     String @id @default(cuid())
  numero Int    @unique @default(autoincrement())

  empresaId String
  comandaId String?
  clienteId String?
  usuarioId String

  status StatusVenda @default(ABERTA)

  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  desconto   Decimal @default(0) @db.Decimal(12, 2)
  acrescimo  Decimal @default(0) @db.Decimal(12, 2)
  valorTotal Decimal @default(0) @db.Decimal(12, 2)

  observacoes String? @db.Text

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  finalizadaEm DateTime?
  canceladaEm  DateTime?

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  comanda Comanda? @relation(fields: [comandaId], references: [id])
  cliente Cliente? @relation(fields: [clienteId], references: [id])
  usuario Usuario  @relation(fields: [usuarioId], references: [id])

  itens             VendaItem[]
  pagamentos        Pagamento[]
  pacotesCliente    PacoteCliente[]
  documentosFiscais DocumentoFiscal[]

  @@index([empresaId])
  @@index([comandaId])
  @@index([clienteId])
  @@index([usuarioId])
  @@index([status])
  @@index([createdAt])
  @@map("vendas")
}

model VendaItem {
  id String @id @default(cuid())

  vendaId        String
  itemCatalogoId String?
  comandaItemId  String?
  petId          String?

  descricao String

  quantidade    Decimal @default(1) @db.Decimal(12, 3)
  valorUnitario Decimal @db.Decimal(12, 2)
  desconto      Decimal @default(0) @db.Decimal(12, 2)
  valorTotal    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  venda        Venda         @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  itemCatalogo ItemCatalogo? @relation(fields: [itemCatalogoId], references: [id])
  comandaItem  ComandaItem?  @relation(fields: [comandaItemId], references: [id])
  pet          Pet?          @relation(fields: [petId], references: [id])

  @@index([vendaId])
  @@index([itemCatalogoId])
  @@index([comandaItemId])
  @@index([petId])
  @@map("venda_itens")
}

model Pagamento {
  id String @id @default(cuid())

  vendaId       String
  sessaoCaixaId String?

  forma  FormaPagamento
  status StatusPagamento @default(PENDENTE)

  valor Decimal @db.Decimal(12, 2)

  parcelas Int? @default(1)

  transacaoExternaId String?
  codigoAutorizacao  String?

  observacoes String? @db.Text

  createdAt DateTime  @default(now())
  pagoEm    DateTime?

  venda       Venda        @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  sessaoCaixa SessaoCaixa? @relation(fields: [sessaoCaixaId], references: [id])

  @@index([vendaId])
  @@index([sessaoCaixaId])
  @@index([status])
  @@index([forma])
  @@index([createdAt])
  @@map("pagamentos")
}

model MovimentacaoCaixa {
  id String @id @default(cuid())

  sessaoCaixaId String
  usuarioId     String

  tipo TipoMovimentacaoCaixa

  valor Decimal @db.Decimal(12, 2)

  descricao String

  referenciaTipo String?
  referenciaId   String?

  createdAt DateTime @default(now())

  sessaoCaixa SessaoCaixa @relation(fields: [sessaoCaixaId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])

  @@index([sessaoCaixaId])
  @@index([usuarioId])
  @@index([tipo])
  @@index([createdAt])
  @@index([referenciaTipo, referenciaId])
  @@map("movimentacoes_caixa")
}

// ======================================================
// RH / FUNCIONÁRIOS / PONTO
// ======================================================

model FuncaoFuncionario {
  id            String @id @default(cuid())
  organizacaoId String

  nome      String
  descricao String?
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao  Organizacao  @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  funcionarios Funcionario[]

  @@unique([organizacaoId, nome])
  @@index([organizacaoId])
  @@map("funcoes_funcionarios")
}

model Funcionario {
  id            String  @id @default(cuid())
  organizacaoId String
  usuarioId     String?
  funcaoId      String?

  nome      String
  cpf       String?
  email     String?
  telefone  String?
  matricula String?

  dataAdmissao DateTime? @db.Date
  dataDemissao DateTime? @db.Date
  salarioBase  Decimal?  @db.Decimal(12, 2)

  status StatusFuncionario @default(ATIVO)

  observacoes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao Organizacao       @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  usuario     Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  funcao      FuncaoFuncionario? @relation(fields: [funcaoId], references: [id], onDelete: SetNull)

  empresas    FuncionarioEmpresa[]
  jornadas    JornadaTrabalho[]
  registros   RegistroPonto[]
  fechamentos FechamentoPonto[]

  @@unique([organizacaoId, cpf])
  @@unique([organizacaoId, matricula])
  @@unique([organizacaoId, usuarioId])
  @@index([organizacaoId])
  @@index([usuarioId])
  @@index([funcaoId])
  @@index([nome])
  @@map("funcionarios")
}

model FuncionarioEmpresa {
  funcionarioId String
  empresaId     String

  principal Boolean @default(false)
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([funcionarioId, empresaId])
  @@index([empresaId])
  @@map("funcionario_empresas")
}

model JornadaTrabalho {
  id            String @id @default(cuid())
  funcionarioId String
  empresaId     String

  diaSemana Int

  entradaPrevista  String
  saidaPrevista    String
  inicioIntervalo  String?
  fimIntervalo     String?

  toleranciaMinutos Int @default(0)
  ativo             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, empresaId, diaSemana])
  @@index([empresaId])
  @@map("jornadas_trabalho")
}

model RegistroPonto {
  id              String @id @default(cuid())
  funcionarioId   String
  empresaId       String
  registradoPorId String?

  tipo   TipoRegistroPonto
  origem OrigemRegistroPonto @default(WEB)

  registradoEm DateTime @default(now())

  ip         String?
  userAgent  String?
  observacao String? @db.Text

  createdAt DateTime @default(now())

  funcionario  Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  empresa      Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  registradoPor Usuario?    @relation("RegistroPontoUsuario", fields: [registradoPorId], references: [id], onDelete: SetNull)
  ajustes      AjustePonto[]

  @@index([funcionarioId, registradoEm])
  @@index([empresaId, registradoEm])
  @@index([registradoPorId])
  @@map("registros_ponto")
}

model AjustePonto {
  id          String @id @default(cuid())
  registroId  String
  usuarioId   String

  horarioAnterior DateTime
  horarioNovo     DateTime
  motivo          String @db.Text

  createdAt DateTime @default(now())

  registro RegistroPonto @relation(fields: [registroId], references: [id], onDelete: Cascade)
  usuario  Usuario      @relation("AjustePontoUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([registroId])
  @@index([usuarioId])
  @@map("ajustes_ponto")
}

model FechamentoPonto {
  id            String @id @default(cuid())
  funcionarioId String
  empresaId     String
  fechadoPorId  String?

  competencia String

  minutosPrevistos   Int @default(0)
  minutosTrabalhados Int @default(0)
  minutosExtras      Int @default(0)
  minutosAtraso      Int @default(0)
  minutosPausa       Int @default(0)
  faltas             Int @default(0)

  status StatusFechamentoPonto @default(ABERTO)

  fechadoEm DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fechadoPor  Usuario?    @relation("FechamentoPontoUsuario", fields: [fechadoPorId], references: [id], onDelete: SetNull)

  @@unique([funcionarioId, empresaId, competencia])
  @@index([empresaId, competencia])
  @@map("fechamentos_ponto")
}

// ======================================================
// PACOTES
// ======================================================

model PacoteModelo {
  id            String @id @default(cuid())
  organizacaoId String
  empresaId     String

  nome      String
  descricao String? @db.Text
  tipo      TipoPacote @default(FIXO)

  valorPacote Decimal @db.Decimal(12, 2)
  validadeDias Int?

  inicioVigencia DateTime? @db.Date
  fimVigencia    DateTime? @db.Date

  visivelPortal Boolean @default(false)
  ativo         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  itens   PacoteModeloItem[]
  compras PacoteCliente[]

  @@index([organizacaoId])
  @@index([empresaId])
  @@index([ativo])
  @@map("pacotes_modelo")
}

model PacoteModeloItem {
  id              String @id @default(cuid())
  pacoteModeloId  String
  itemCatalogoId  String

  quantidade Decimal @default(1) @db.Decimal(12, 3)

  pacoteModelo PacoteModelo @relation(fields: [pacoteModeloId], references: [id], onDelete: Cascade)
  itemCatalogo ItemCatalogo @relation(fields: [itemCatalogoId], references: [id], onDelete: Restrict)

  @@unique([pacoteModeloId, itemCatalogoId])
  @@index([itemCatalogoId])
  @@map("pacote_modelo_itens")
}

model PacoteCliente {
  id            String @id @default(cuid())
  organizacaoId String
  empresaId     String
  modeloId      String?
  clienteId     String
  petId         String?
  vendaId       String?

  tipo TipoPacote
  nome String

  valorPacote Decimal @db.Decimal(12, 2)

  inicioValidade DateTime @db.Date
  fimValidade    DateTime? @db.Date

  status StatusPacoteCliente @default(ATIVO)

  observacoes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizacao Organizacao  @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  modelo      PacoteModelo? @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pet         Pet?         @relation(fields: [petId], references: [id], onDelete: SetNull)
  venda       Venda?       @relation(fields: [vendaId], references: [id], onDelete: SetNull)

  itens PacoteClienteItem[]

  @@index([organizacaoId])
  @@index([empresaId])
  @@index([clienteId])
  @@index([petId])
  @@index([status])
  @@map("pacotes_clientes")
}

model PacoteClienteItem {
  id               String @id @default(cuid())
  pacoteClienteId  String
  itemCatalogoId   String

  quantidadeTotal     Decimal @db.Decimal(12, 3)
  quantidadeConsumida Decimal @default(0) @db.Decimal(12, 3)

  pacoteCliente PacoteCliente @relation(fields: [pacoteClienteId], references: [id], onDelete: Cascade)
  itemCatalogo  ItemCatalogo  @relation(fields: [itemCatalogoId], references: [id], onDelete: Restrict)

  consumos ConsumoPacote[]

  @@unique([pacoteClienteId, itemCatalogoId])
  @@index([itemCatalogoId])
  @@map("pacote_cliente_itens")
}

model ConsumoPacote {
  id                  String @id @default(cuid())
  pacoteClienteItemId String
  usuarioId           String?
  petId               String?

  quantidade Decimal @db.Decimal(12, 3)

  origemTipo String?
  origemId   String?
  observacao String? @db.Text

  consumidoEm DateTime @default(now())

  pacoteClienteItem PacoteClienteItem @relation(fields: [pacoteClienteItemId], references: [id], onDelete: Cascade)
  usuario            Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  pet                Pet?              @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@index([pacoteClienteItemId])
  @@index([consumidoEm])
  @@map("consumos_pacote")
}

// ======================================================
// FISCAL - FUNDAÇÃO PARA INTEGRAÇÃO FUTURA
// ======================================================

model ConfiguracaoFiscalEmpresa {
  id        String @id @default(cuid())
  empresaId String @unique

  regime   RegimeTributario @default(OUTRO)
  ambiente AmbienteFiscal   @default(HOMOLOGACAO)

  provedorFiscal String?

  serieNfe  String?
  serieNfce String?
  serieNfse String?

  certificadoReferencia String?
  certificadoValidoAte  DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_fiscais_empresas")
}

model ConfiguracaoFiscalItem {
  id             String @id @default(cuid())
  itemCatalogoId String @unique

  ncm                    String?
  cest                   String?
  cfop                   String?
  origemMercadoria       String?
  cstCsosn               String?
  codigoServicoMunicipal String?

  aliquotaIcms Decimal? @db.Decimal(7, 4)
  aliquotaIss  Decimal? @db.Decimal(7, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemCatalogo ItemCatalogo @relation(fields: [itemCatalogoId], references: [id], onDelete: Cascade)

  @@map("configuracoes_fiscais_itens")
}

model DocumentoFiscal {
  id        String @id @default(cuid())
  empresaId String
  vendaId   String?

  tipo   TipoDocumentoFiscal
  status StatusDocumentoFiscal @default(PENDENTE)

  numero String?
  serie  String?
  chave  String?

  valorTotal Decimal? @db.Decimal(12, 2)

  protocolo String?
  xmlUrl    String?
  pdfUrl    String?

  mensagemErro String? @db.Text

  emitidoEm   DateTime?
  canceladoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  venda   Venda?   @relation(fields: [vendaId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@index([vendaId])
  @@index([status])
  @@index([chave])
  @@map("documentos_fiscais")
}

// ======================================================
// AUDITORIA
// ======================================================

model Auditoria {
  id            String @id @default(cuid())
  organizacaoId String
  empresaId     String?
  usuarioId     String?

  acao      String
  entidade  String
  entidadeId String?

  dadosAnteriores Json?
  dadosNovos      Json?

  ip String?

  createdAt DateTime @default(now())

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  empresa     Empresa?    @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([organizacaoId, createdAt])
  @@index([empresaId, createdAt])
  @@index([usuarioId, createdAt])
  @@index([entidade, entidadeId])
  @@map("auditoria")
}

// ======================================================
// SESSÕES DE AUTENTICAÇÃO
// ======================================================

model SessaoUsuario {
  id String @id @default(cuid())

  usuarioId String

  refreshTokenHash String

  userAgent String?
  ip        String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessoes_usuario")
}
