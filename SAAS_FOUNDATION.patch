+function validar(schema, body, res) {
+  const resultado = schema.safeParse(body);
+  if (!resultado.success) {
+    res.status(400).json({
+      success: false,
+      message: "Dados inválidos.",
+      errors: resultado.error.flatten().fieldErrors,
+    });
+    return null;
+  }
+  return resultado.data;
+}
