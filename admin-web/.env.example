# Opcional. O fluxo recomendado usa PETRISE_API_URL no serviço Railway em runtime.
# Em desenvolvimento local, sem variável, o fallback é http://localhost:3000/api.
VITE_API_URL=http://localhost:3000/api

# Explicitly set to "staging" ONLY for the isolated homologation build.
# Keep unset (or "production") for production builds.
VITE_POINTVET_ENVIRONMENT=production
